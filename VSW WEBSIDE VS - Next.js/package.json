    "start": "next start --port 5180",
    "preview": "next start --port 4173"
  },
  "dependencies": {
    "gsap": "latest",
    "lucide-react": "latest",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.6"
  }
}
