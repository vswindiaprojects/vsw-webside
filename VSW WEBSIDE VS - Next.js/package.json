{
  "name": "vsw-solutions-next",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 5180",
    "frontend": "next dev --port 5180",
    "backend": "npm --prefix 02-BACKEND start",
    "backend:dev": "npm --prefix 02-BACKEND run dev",
    "dev:all": "concurrently -k \"npm:frontend\" \"npm:backend:dev\"",
    "seed:admin": "npm --prefix 02-BACKEND run seed:admin",
    "lint": "eslint app next.config.mjs",
